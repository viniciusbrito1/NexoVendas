<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Cron job para atualizar status das rotas automaticamente -->
        <record id="ir_cron_consignado_update_status" model="ir.cron">
            <field name="name">Consignado: Atualizar Status das Rotas</field>
            <field name="model_id" ref="model_consignado_rota"/>
            <field name="state">code</field>
            <field name="code">model.cron_atualizar_status_rotas()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
